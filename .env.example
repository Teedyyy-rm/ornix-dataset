# Ornix Dataset — environment template.
#
# Copy to `.env` (which is git-ignored) and fill in your own values:
#     cp .env.example .env
#
# The CLI loads `.env` at startup; real environment variables always take
# precedence. Secrets are never printed or committed.

# --- Required for any Hugging Face operation (download / inventory / publish) ---
# Create a fine-grained token with WRITE access to ONLY the destination dataset
# repo: https://huggingface.co/settings/tokens
HF_TOKEN=hf_replace_with_your_token

# --- Optional ---
# Hugging Face cache / Xet download directory (kept out of git via `cache/`).
# HF_HOME=./cache
#
# Point at a different env file instead of the nearest `.env`:
# ORNIX_ENV_FILE=/secure/path/ornix.env
